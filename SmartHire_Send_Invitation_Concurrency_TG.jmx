            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 2xx" enabled="false">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="-954507776">^2\d\d$</stringProp>
