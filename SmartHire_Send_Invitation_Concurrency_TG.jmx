                    <stringProp name="Argument.value">{&quot;first_name&quot;:&quot;${rand_first}&quot;,&quot;last_name&quot;:&quot;${rand_last}&quot;,&quot;email&quot;:&quot;${rand_email}&quot;,&quot;phone&quot;:&quot;${rand_phone}&quot;,&quot;job_id&quot;:&quot;${job_id}&quot;}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
