          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="TC05_Send_Invitation" enabled="true">
            <boolProp name="TransactionController.parent">true</boolProp>
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>
            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell - Random Invitee Data" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.Random;
Random rnd = new Random();
String[] firstNames = {&quot;Aarav&quot;,&quot;Sanya&quot;,&quot;Rohan&quot;,&quot;Meera&quot;,&quot;Kiran&quot;,&quot;Anil&quot;,&quot;Priya&quot;,&quot;Vikram&quot;,&quot;Neha&quot;,&quot;Arjun&quot;};
String[] lastNames = {&quot;Sharma&quot;,&quot;Reddy&quot;,&quot;Naidu&quot;,&quot;Patel&quot;,&quot;Iyer&quot;,&quot;Gupta&quot;,&quot;Rao&quot;,&quot;Mehta&quot;,&quot;Nair&quot;,&quot;Singh&quot;};
String first = firstNames[rnd.nextInt(firstNames.length)];
String last = lastNames[rnd.nextInt(lastNames.length)];
long stamp = System.currentTimeMillis();
String email = &quot;lt_&quot; + first.toLowerCase() + &quot;_&quot; + stamp + &quot;_&quot; + rnd.nextInt(1000) + &quot;@yopmail.com&quot;;
String phone = &quot;9&quot; + String.valueOf(100000000 + rnd.nextInt(899999999));
vars.put(&quot;rand_first&quot;, first);
vars.put(&quot;rand_last&quot;, last);
vars.put(&quot;rand_email&quot;, email);
vars.put(&quot;rand_phone&quot;, phone);
log.info(&quot;Random invitee: &quot; + first + &quot; &quot; + last + &quot; &quot; + email + &quot; &quot; + phone);
</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If session_id found" enabled="true">
              <stringProp name="IfController.condition">${__groovy(vars.get(&quot;session_id&quot;) != &quot;SESSION_NOT_FOUND&quot;)}</stringProp>
              <boolProp name="IfController.evaluateAll">false</boolProp>
              <boolProp name="IfController.useExpression">true</boolProp>
            </IfController>
            <hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST Resend / Send invitation" enabled="true">
                <stringProp name="HTTPSampler.path">/api/v1/interviews/sessions/${session_id}/resend-invite/</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
